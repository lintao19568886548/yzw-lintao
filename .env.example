# Cloudflare R2（可复用 MyIndex005 的同一存储桶）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=blog-r2
R2_PUBLIC_BASE_URL=https://r2.example.com

# Web 端公开来源（二维码、分享链接、页面自举默认来源）。
YIZU_PUBLIC_APP_ORIGIN=https://app.example.com

# Web 客户端直连的 SpacetimeDB 来源。
# 正式环境建议使用 HTTPS，SDK 会建立对应的安全 WebSocket 连接。
YIZU_SPACETIMEDB_URI=https://spacetimedb.example.com

# 服务端用于校验浏览器提交的 SpacetimeDB 身份令牌
YIZU_SPACETIMEDB_SERVER_URL=https://yz.furong.org
YIZU_SPACETIMEDB_DATABASE=yizu-server-yz18m

# AI Excel 账单识别（密钥只由 Dioxus 服务端读取）
ALIYUN_BAILIAN_KEY=
YIZU_AMOUNT_BILL_AI_MODEL=qwen3.5-plus
YIZU_CONTRACT_AI_MODEL=qwen3.5-plus

# YMSINO 智能抄表（未填写时兼容原项目默认测试配置）
YIZU_YMSINO_BASE_URL=http://pt.ymsino1.com/ymcb/inter
YIZU_YMSINO_USERNAME=
YIZU_YMSINO_PASSWORD=
YIZU_YMSINO_ORG_ID=1024
YIZU_YMSINO_PT_ID=YZWL
YIZU_YMSINO_TIMEOUT_SECONDS=15
YIZU_YMSINO_ELECTRIC_PROTOCOL=M-Bus
YIZU_YMSINO_WATER_PROTOCOL=

# 合众智能电表（正式系统当前使用项目 241）
YIZU_HEZHONG_BASE_URL=https://devhzeb.szhzzd.top
YIZU_HEZHONG_USERNAME=
YIZU_HEZHONG_LOGIN_KEY=
YIZU_HEZHONG_PROJECT_CODE=241
YIZU_HEZHONG_ELECTRIC_COM_TYPE=D.ZDG.FIWBM-GD04
YIZU_HEZHONG_TIMEOUT_SECONDS=15
YIZU_HEZHONG_CONNECT_TIMEOUT_SECONDS=6
YIZU_HEZHONG_RETRY_ATTEMPTS=3
YIZU_HEZHONG_RETRY_DELAY_MS=300
YIZU_HEZHONG_OPERATION_TIMEOUT_SECONDS=20
YIZU_HEZHONG_CACHE_SECONDS=300
